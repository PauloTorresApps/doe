{
  "name": "doe-backend",
  "version": "1.0.0",
  "description": "DOE Tocantins backend - Fastify + BullMQ",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "worker": "tsx src/workers/start.ts",
    "worker:dev": "tsx watch src/workers/start.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/jwt": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.0.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "ioredis": "^5.4.0",
    "jose": "^6.1.3",
    "pino": "^10.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/pino": "^7.0.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "pg": "^8.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
